rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    // Fields managed exclusively by Cloud Functions — clients cannot touch them
    function noRankTampering() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys().hasAny(['worldRank', 'clubRank', 'clubScore', 'memberCount']);
    }

    // ── Username lookup ───────────────────────────────────────────────────────
    match /usernames/{username} {
      allow read: if true;
      allow create: if isOwner(request.resource.data.uid);
      allow update, delete: if false;
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAuthed();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) && noRankTampering();
      allow delete: if false;

      match /matches/{matchId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        allow update, delete: if false;
      }

      // Track answered question IDs per category
      match /categoryProgress/{catId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid);
      }
    }

    // ── Questions ─────────────────────────────────────────────────────────────
    match /questions/{questionId} {
      allow read: if isAuthed();
      allow write: if false;
    }

    // ── Daily Sorts ───────────────────────────────────────────────────────────
    match /dailySorts/{date} {
      allow read: if isAuthed();
      allow write: if false;
    }

    // ── Clubs ─────────────────────────────────────────────────────────────────
    match /clubs/{clubId} {
      allow read: if isAuthed();
      allow create: if isAuthed() && request.resource.data.creatorUid == request.auth.uid;
      allow update: if isAuthed() && resource.data.creatorUid == request.auth.uid && noRankTampering();
      allow delete: if isAuthed() && resource.data.creatorUid == request.auth.uid;

      match /members/{memberId} {
        allow read: if isAuthed();
        allow create, delete: if isOwner(memberId);
        allow update: if isOwner(memberId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clubScore']);
      }
    }

    // ── Challenges (VS Mode) ──────────────────────────────────────────────────
    match /challenges/{challengeId} {
      function isInChallenge() {
        return isAuthed() && (
          request.auth.uid in resource.data.playerUids ||
          request.auth.uid == resource.data.challengerUid ||
          request.auth.uid == resource.data.opponentUid
        );
      }
      
      // Helper for sub-collections to check the parent challenge
      function canAccessParent() {
        let challenge = get(/databases/$(database)/documents/challenges/$(challengeId)).data;
        return isAuthed() && request.auth.uid in challenge.playerUids;
      }

      allow read: if isInChallenge();
      
      // Anyone can create a challenge as long as they are one of the players
      allow create: if isAuthed() && (
        request.auth.uid in request.resource.data.playerUids ||
        request.auth.uid == request.resource.data.challengerUid
      );

      // Both players can update status, ready flags, starts, and rematch info
      allow update: if isInChallenge() 
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'challengerReady', 'opponentReady', 'startedAt', 'rematchRequestedBy', 'winnerUid', 'draw', 'rematchId', 'finishedUids']);

      match /answers/{uid} {
        allow read: if canAccessParent();
        allow write: if isOwner(uid);
      }

      match /messages/{msgId} {
        allow read: if canAccessParent();
        allow create: if isAuthed();
      }
    }

    // ── Actually (myth-buster swipe game) ──────────────────────────────────────
    // Separate collections for a sibling app sharing this Firebase project's
    // Auth users/Firestore — see usernames/users above for shared identity.
    match /actuallyProfiles/{uid} {
      allow read: if isAuthed();
      allow create, update: if isOwner(uid);
      allow delete: if false;

      // Fact IDs this player has already played — existence = seen, used to
      // keep facts from repeating. Doc content is irrelevant, only its id.
      // Read is any authed user (not just the owner): building a versus
      // deck needs to read *both* players' seen-facts, not just the caller's.
      match /seenFacts/{factId} {
        allow read: if isAuthed();
        allow create: if isOwner(uid);
        allow update, delete: if false;
      }
    }

    match /actuallyMatches/{matchId} {
      allow read: if isAuthed() && resource.data.uid == request.auth.uid;
      allow create: if isAuthed() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /actuallyFacts/{factId} {
      allow read: if isAuthed();
      allow write: if false;
    }

    // 1v1 online versus matches (invite-by-username) — separate from
    // SORTA's own challenges collection above.
    match /actuallyChallenges/{challengeId} {
      function isInActuallyChallenge() {
        return isAuthed() && (
          request.auth.uid == resource.data.challengerUid ||
          request.auth.uid == resource.data.opponentUid
        );
      }

      function canAccessActuallyChallengeParent() {
        let challenge = get(/databases/$(database)/documents/actuallyChallenges/$(challengeId)).data;
        return isAuthed() && (
          request.auth.uid == challenge.challengerUid ||
          request.auth.uid == challenge.opponentUid
        );
      }

      allow read: if isInActuallyChallenge();
      allow create: if isAuthed() && request.auth.uid == request.resource.data.challengerUid;
      allow update: if isInActuallyChallenge()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'challengerReady', 'opponentReady', 'startedAt', 'rematchRequestedBy', 'finishedUids']);

      match /answers/{uid} {
        allow read: if canAccessActuallyChallengeParent();
        allow write: if isOwner(uid);
      }
    }

    // Community-submitted myth facts, voted on by other players. Only the
    // actuallyOnFactVoteCreated Cloud Function (admin SDK, bypasses rules)
    // may touch agreeCount/disagreeCount/status/voterUids or promote into
    // actuallyFacts — clients may only create their own submission or vote.
    match /actuallyFactSubmissions/{submissionId} {
      allow read: if isAuthed();
      allow create: if isAuthed()
        && request.auth.uid == request.resource.data.submitterUid
        && request.resource.data.status == 'pending'
        && request.resource.data.agreeCount == 0
        && request.resource.data.disagreeCount == 0;
      allow update, delete: if false;

      match /votes/{voterUid} {
        allow read: if isAuthed();
        allow create: if isOwner(voterUid)
          && voterUid != get(/databases/$(database)/documents/actuallyFactSubmissions/$(submissionId)).data.submitterUid;
        allow update, delete: if false;
      }
    }
  }
}
